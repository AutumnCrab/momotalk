# ── 개인 설정 / 민감 정보 (직접 만들어서 채워야 함, .example.json 참고) ──
config.json
anniversaries.json
chat_history.json
event_dates.json
proactive_state.json
ui_state.json

# ── 백업본 (build_exe.bat이 만드는 임시 백업 + 수동 백업) ──
_backup_*.json

# ── 실행 로그 (pythonw로 실행되면 콘솔이 없어서 파일로 남김) ──
momotalk.log

# ── PyInstaller 빌드 산출물 (build_exe.bat으로 언제든 재생성 가능) ──
dist/
build/
*.spec.bak

# ── 파이썬 ──
__pycache__/
*.pyc
.venv/
venv/

# ── OS / 에디터 ──
.vscode/
.DS_Store
Thumbs.db
